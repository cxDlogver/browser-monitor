NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:8080
API_PORT=3000
DATABASE_URL=postgres://monitor:monitor@localhost:5432/monitor
REDIS_URL=redis://localhost:6379
COOKIE_SECRET=replace-with-at-least-32-random-characters
USER_HASH_SECRET=replace-with-another-32-character-secret
AUDIT_HEADER_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Browser Monitor <monitor@example.test>
SESSION_TTL_SECONDS=604800
ALLOW_ORIGINLESS_INGEST=false
INGEST_PROJECT_RATE_PER_SECOND=100
INGEST_PROJECT_BURST=500
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=100
AUDIT_POLL_INTERVAL_MS=2000
AUDIT_CHROME_PATH=
AUDIT_ALLOW_PRIVATE_TARGETS=false
# Docker 构建 Chromium 时使用的 Debian HTTPS 镜像；国内网络可改为：
# https://mirrors.tuna.tsinghua.edu.cn
DEBIAN_MIRROR_BASE=https://deb.debian.org
