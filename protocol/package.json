{
  "name": "@cxdlogver/browser-monitor-protocol",
  "version": "3.0.0",
  "description": "Runtime schemas and TypeScript contracts shared by Browser Monitor SDK and platform.",
  "author": "cxDlogver",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cxDlogver/browser-monitor.git",
    "directory": "protocol"
  },
  "bugs": {
    "url": "https://github.com/cxDlogver/browser-monitor/issues"
  },
  "homepage": "https://github.com/cxDlogver/browser-monitor/tree/main/protocol#readme",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
